# Auto-detect text and normalize to LF in repo; checkout as-is on Windows
* text=auto

# Python files always LF
*.py text eol=lf
*.sh text eol=lf

# Web assets LF
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.svg text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.gif binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
